config_version=5

[application]
config/name="Krusher Art Review"
config/use_custom_user_dir=true
config/custom_user_dir_name="KrusherArtReviewScratch"

[display]
window/size/viewport_width=1200
window/size/viewport_height=720
window/size/window_width_override=1200
window/size/window_height_override=720

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.153,0.169,0.18,1)
