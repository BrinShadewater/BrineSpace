extends "res://tools/audition_ui_badges.gd"
## Second badge board. Sample data only; no live state or save access.
func add_readout(body: VBoxContainer, item: PanelContainer) -> void:
	body.add_child(item)
	samples.append(item)
func run() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://output/ui-badges-2026-10-03"))
	var viewport := SubViewport.new()
	viewport.size = Vector2i(1440,1000)
	viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	root.add_child(viewport)
	var stage := Control.new()
	stage.theme = Style.menu_theme()
	stage.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	viewport.add_child(stage)
	var background := ColorRect.new()
	background.color = Color("0a1d25")
	background.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	stage.add_child(background)
	var margin := MarginContainer.new()
	margin.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	for side in ["left","right","top","bottom"]: margin.add_theme_constant_override("margin_"+side,28)
	stage.add_child(margin)
	var body := VBoxContainer.new()
	body.add_theme_constant_override("separation",18)
	margin.add_child(body)
	body.add_child(heading("BRINESPACE / BADGES II",30))
	body.add_child(Widgets.text_label("Room conditions  ·  signed resource flow  ·  vitals  ·  compact navigation markers",17,true))
	var grid := GridContainer.new()
	grid.columns = 2
	grid.add_theme_constant_override("h_separation",18)
	grid.add_theme_constant_override("v_separation",18)
	body.add_child(grid)
	var conditions := family(grid,"ROOM CONDITIONS","Distinct symbols and captions keep similar warnings readable.")
	line(conditions,[["Frozen","freeze","research"],["Damaged","integrity","warning"],["Corrupted","corruption","danger"]])
	line(conditions,[["Doors open","doors_open","online"],["Doors closed","doors_closed","normal"]],true)
	var flow_body := family(grid,"RESOURCE FLOW","Signed amounts retain their units and full value.")
	add_readout(flow_body,Badges.flow("oxygen",4))
	add_readout(flow_body,Badges.flow("power",-12,true))
	add_readout(flow_body,Badges.flow("water",0,true))
	var vitals := family(grid,"CREW VITALS","Compact numeric readouts with caller-supplied warning states.")
	add_readout(vitals,Badges.vital("Health","health",84,"online"))
	add_readout(vitals,Badges.vital("Fatigue","fatigue",62,"warning",true))
	add_readout(vitals,Badges.vital("Hunger","hunger",38,"normal",true))
	var navigation := family(grid,"NAVIGATION MARKERS","Small counts for journal, archive and diagnostic destinations.")
	line(navigation,[["Journal","journal","normal",4],["Archive","archive","research",28]])
	line(navigation,[["Diagnostics","diagnostics","warning",2],["Help","help","normal"]],true)
	var station := family(grid,"STATION READOUTS","Totals stay readable beyond the notification-count limit.")
	add_readout(station,Badges.readout("Metal","metal","1,240"))
	add_readout(station,Badges.readout("Archived data","archived_data","128", "research",true))
	add_readout(station,Badges.readout("Integrity","integrity","93%","online",true))
	var contextual := family(grid,"CONTEXT / LIST ROW","Paired badges wrap naturally in narrow inspector layouts.")
	var narrow := VBoxContainer.new()
	narrow.custom_minimum_size.x = 320
	narrow.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
	contextual.add_child(narrow)
	line(narrow,[["Needs repair","repair","warning"],["Assigned","assigned_room","online"],["No input","warning","warning"],["Paused","pause","disabled"]],true)
	contextual.add_child(Widgets.text_label("Compact 28 px  /  Standard 36 px\nValues shown here are audition samples.",15,true))
	for frame in range(5): await process_frame
	await RenderingServer.frame_post_draw
	check(grid.get_global_rect().end.y <= 1000,"Extended board fits viewport")
	for item in samples:
		check(item.get_node("Content/Icon").texture != null,"Icon source loads")
		check(item.get_node("Content").get_global_rect().end.x <= item.get_global_rect().end.x,"Contents fit badge")
		check(item.size.y <= 36,"Badge respects intended height")
	check(narrow.size.x <= 320,"Context badges wrap within narrow inspector width")
	for entry in [["oxygen",128,"+128 / CYCLE"],["power",-12,"-12 / CYCLE"],["water",0,"0 / CYCLE"]]:
		var probe := Badges.flow(entry[0],entry[1])
		check(probe.get_node("Content/Value").text == entry[2],"Resource flow preserves sign and value")
		probe.free()
	for entry in [[-10,"0%"],[110,"100%"]]:
		var probe := Badges.vital("Health","health",entry[0])
		check(probe.get_node("Content/Value").text == entry[1],"Vital clamps to percentage range")
		probe.free()
	check(viewport.get_texture().get_image().save_png("res://output/ui-badges-2026-10-03/badges-audition.png") == OK,"Extended board saves")
	print("EXTENDED BADGE AUDITION: %d checks, %d failures" % [checks,failures])
	quit(1 if failures else 0)
