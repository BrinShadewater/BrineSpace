# Godot-generated editor/import data
.godot/
*.import
*.tmp

# Local design and audit artifacts; source art stays in the full local project.
asset_backups/
outputs/
/output/

# Local editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local Python asset-tool caches
__pycache__/
*.pyc
/output/cover-tools/

# Local verified Godot templates and room-validation binaries
/output/production-ten/export-tools/
/output/production-ten/windows-validation*/

# Local playable Windows builds
/builds/

# Generated by tools/build_release_manifest.py; embedded into release packages.
/build_info.json
/assets/runtime-release.json

# Third-party agent skills installed by "npx skills add" (Higgsfield); local tooling, not game source.
.agents/
.superpowers/
.claude/
skills-lock.json

# Bought art packs exactly as the vendors ship them: licensed, large, and the tools' --sources.
/vendor-art/

